# Copia a .env y ajusta. El procesador falla con un mensaje claro si falta DB_*.

# --- PostgreSQL ---
DB_NAME=postgresdb
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=cambia_esta_password
DB_PORT=5432
# Tabla destino (schema.tabla). Debe existir; db/init.sql crea test.kpis.
DB_TABLE=test.kpis

# --- Kafka ---
# En compose usa kafka:9092; desde el host, localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=test
KAFKA_GROUP=kpi-processor

# --- Batching ---
# El flush ocurre al cumplir cualquiera de las dos condiciones.
KPI_FLUSH_INTERVAL=2.0
KPI_FLUSH_MAX_ROWS=500

# --- CloudBeaver (perfil tools) ---
CB_ADMIN_PASSWORD=admin123
